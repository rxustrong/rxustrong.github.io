---
import type { CollectionEntry } from 'astro:content';
import { slugOf } from '../utils/slug';
import { formatDate, growthLabels, topicUrl } from '../utils/garden';
interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
const { title, description, date, growth, category, tags, draft, demo } = post.data;
---
<article class="post-card"><div class="card-top"><span class={`growth-label ${growth}`}><i class={`growth-dot ${growth}`}></i>{growthLabels[growth]}</span><span class="category">{category}</span></div>{(draft || demo) && <span class="draft-label">{demo ? '开发示例 · 草稿' : '本地草稿'}</span>}<h3><a href={`/posts/${slugOf(post)}/`}>{title}</a></h3>{description && <p class="card-description">{description}</p>}<div class="card-bottom"><time datetime={formatDate(date)}>{formatDate(date)}</time><div class="card-tags">{tags.slice(0, 2).map(tag => <a href={topicUrl(tag)}>{tag}</a>)}</div></div></article>
