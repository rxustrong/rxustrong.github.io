---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { gardenPosts, categories, growthLabels } from '../../utils/garden';
const posts = await gardenPosts();
---
<Layout title="花园" active="posts"><section class="page-heading shell"><p class="eyebrow">THE DIGITAL GARDEN</p><h1>一座想法的花园</h1><p>记录尝试，整理发现，也为尚未想清楚的问题留一点空间。</p></section><section class="shell garden-list"><div class="filter-bar" role="group" aria-label="按栏目筛选"><button class="filter active" data-category="all" aria-pressed="true">全部</button>{categories.map(category => <button class="filter" data-category={category} aria-pressed="false">{category}</button>)}</div><div class="growth-explanation">{Object.entries(growthLabels).map(([key, label]) => <span><i class={`growth-dot ${key}`}></i>{label}</span>)}<span class="results-count">共 <span id="result-count">{posts.length}</span> 篇</span></div><div class="post-grid">{posts.map(post => <div data-post-category={post.data.category}><PostCard post={post} /></div>)}</div><div class="empty-state" id="filter-empty" hidden={posts.length > 0}><span aria-hidden="true">❧</span><h2>这里的想法还在酝酿。</h2><p>这个栏目暂时没有文章。可以换个栏目，或沿着主题继续走走。</p><a class="quiet-link" href="/topics/">浏览主题 ↗</a></div><noscript><p class="muted">以下展示全部文章；也可以使用主题页和时间归档浏览。</p></noscript></section></Layout>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-category]');
  const cards = document.querySelectorAll<HTMLElement>('[data-post-category]');
  const select = (category: string) => {
    let count = 0;
    cards.forEach(card => { const visible = category === 'all' || card.dataset.postCategory === category; card.hidden = !visible; if (visible) count++; });
    buttons.forEach(button => { const active = button.dataset.category === category; button.classList.toggle('active', active); button.setAttribute('aria-pressed', String(active)); });
    document.getElementById('result-count')!.textContent = String(count);
    document.getElementById('filter-empty')!.hidden = count > 0;
  };
  buttons.forEach(button => button.addEventListener('click', () => select(button.dataset.category!)));
  const tag = new URLSearchParams(location.search).get('tag');
  if (tag) location.replace(`/topics/${encodeURIComponent(tag)}/`);
</script>
