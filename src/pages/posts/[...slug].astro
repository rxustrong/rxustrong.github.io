---
import Layout from '../../layouts/Layout.astro';
import { render } from 'astro:content';
import { slugOf } from '../../utils/slug';
import { gardenPosts, growthLabels, formatDate, topicUrl } from '../../utils/garden';
export async function getStaticPaths() {
  return (await gardenPosts()).map(post => ({ params: { slug: slugOf(post) }, props: { post } }));
}
const { post } = Astro.props;
const { title, description, date, updateDate, tags, category, growth, draft, demo } = post.data;
const { Content, headings } = await render(post);
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
const related = (await gardenPosts()).filter(p => p.id !== post.id && p.data.tags.some(tag => tags.includes(tag))).slice(0, 3);
---
<Layout title={title} description={description} active="posts" article><article class="post-layout shell"><div class="post-body"><header class="article-header"><a class="back-link" href="/posts/">← 回到花园</a><div class="article-kind"><span>{category}</span><span class={`growth-label ${growth}`}><i class={`growth-dot ${growth}`}></i>{growthLabels[growth]}</span></div>{(draft || demo) && <p class="draft-notice">{demo ? '开发排版示例，用于本地检查，不会公开发布。' : '这是一篇本地草稿，不会出现在正式网站。'}</p>}<h1>{title}</h1>{description && <p class="article-summary">{description}</p>}<div class="article-meta"><time datetime={formatDate(date)}>{formatDate(date)}</time>{updateDate && <span>修订于 {formatDate(updateDate)}</span>}<div class="card-tags">{tags.map(tag => <a href={topicUrl(tag)}>{tag}</a>)}</div></div></header><div class="prose"><Content /></div><div class="article-end"><span aria-hidden="true">❧</span><p>想法会生长。这篇记录也可能继续修订。</p><a href="/archive/">沿着时间继续阅读 →</a></div>{related.length > 0 && <section class="related"><h2>相关的几片叶子</h2>{related.map(p => <a href={`/posts/${slugOf(p)}/`}>{p.data.title}<span aria-hidden="true">↗</span></a>)}</section>}</div>{toc.length > 0 && <aside class="toc"><p class="eyebrow">这篇记录</p><nav aria-label="文章目录">{toc.map(h => <a class:list={[{ 'toc-sub': h.depth === 3 }]} href={`#${h.slug}`}>{h.text}</a>)}</nav></aside>}</article></Layout>
